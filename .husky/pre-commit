#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Check if there are staged changes inside the design system tokens folder
if git diff --cached --name-only | grep -q "^src/components/design-system/tokens/"; then
  echo "🎨 Design System token changes detected. Rebuilding tokens..."
  npm run tokens:build
  # Add the generated tokens.css file back to the commit
  git add src/components/design-system/tokens/tokens.css
fi

# Run linting
npm run lint

# Run tests
npm test
